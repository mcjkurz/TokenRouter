# TokenRouter Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Password for admin panel authentication
ADMIN_PASSWORD=your-secure-admin-password

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Host to bind the server to (use 0.0.0.0 for external access)
HOST=127.0.0.1

# Port to run the server on
PORT=8000

# Public URL for API documentation (shown to users for client configuration)
PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# MODEL SETTINGS
# =============================================================================

# Default model shown in usage examples (should match a model in providers.json)
DEFAULT_MODEL=gpt-4o

# Timeout for provider API requests (in seconds)
PROVIDER_TIMEOUT=120.0

# =============================================================================
# DATABASE
# =============================================================================

# SQLite database URL
DATABASE_URL=sqlite:///./data/tokenrouter.db

# =============================================================================
# USER REGISTRATION
# =============================================================================

# Enable or disable user registration (true/false)
REGISTRATION_ENABLED=true

# Comma-separated access codes required for registration (leave empty to disable)
REGISTRATION_ACCESS_CODES=

# Comma-separated list of allowed email domains for registration
ALLOWED_EMAIL_DOMAINS=ln.hk,ln.edu.hk

# Default token quota for newly registered users
DEFAULT_REGISTRATION_QUOTA=500000

# =============================================================================
# API DOCUMENTATION
# =============================================================================

# Enable Swagger/OpenAPI documentation at /docs (true/false)
ENABLE_API_DOCS=false

# =============================================================================
# PROVIDER CONFIGURATION
# =============================================================================
# 
# Providers are now configured in providers.json instead of environment variables.
# 
# 1. Copy providers.example.json to providers.json:
#    cp providers.example.json providers.json
# 
# 2. Edit providers.json to add your upstream providers:
#    {
#      "default_provider": "ollama",
#      "providers": {
#        "ollama": {
#          "base_url": "http://localhost:11434/v1",
#          "api_key": null,
#          "models": ["llama3:*", "mistral:*"]
#        },
#        "openai": {
#          "base_url": "https://api.openai.com/v1",
#          "api_key": "sk-your-key",
#          "models": ["gpt-4*", "gpt-3.5*"]
#        }
#      }
#    }
# 
# Model pattern matching:
#   - "gpt-4*"     matches gpt-4, gpt-4o, gpt-4-turbo, etc.
#   - "llama3:*"   matches llama3:8b, llama3:70b, etc.
#   - "claude-3"   matches exactly "claude-3"
#   - "*"          matches everything (use for catch-all/fallback)
# 
# The default_provider is used as a fallback when no other provider
# matches the requested model.
