# TokenRouter Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# Password for admin panel authentication
ADMIN_PASSWORD=your-secure-admin-password

# =============================================================================
# REGISTRATION
# =============================================================================

# Enable or disable user registration (true/false)
REGISTRATION_ENABLED=true

# Comma-separated access codes required for registration
REGISTRATION_ACCESS_CODES=code1,code2

# Comma-separated list of allowed email domains for registration
ALLOWED_EMAIL_DOMAINS=example.com,company.org

# Default token quota for newly registered users
DEFAULT_REGISTRATION_QUOTA=500000

# =============================================================================
# OPTIONAL
# =============================================================================

# Public URL shown to users in registration (for client configuration)
PUBLIC_API_URL=https://your-api-domain.com/v1

# Default model shown in usage examples (should match a model in providers.json)
DEFAULT_MODEL=gpt-5.1

# Timeout for provider API requests (in seconds)
PROVIDER_TIMEOUT=120.0

# Max bytes stored per request/response payload in request_logs (0 disables payload logging)
LOG_PAYLOAD_MAX_BYTES=8192

# =============================================================================
# PROVIDER CONFIGURATION
# =============================================================================
# 
# Providers are configured in providers.json (not here).
# 
# 1. Copy providers.example.json to providers.json
# 2. Edit providers.json to add your upstream providers
# 
# Example providers.json:
# {
#   "default_provider": "ollama",
#   "providers": {
#     "ollama": {
#       "base_url": "http://localhost:11434/v1",
#       "api_key": null,
#       "models": ["llama3:*", "mistral:*", "qwen*", "gpt-oss*"]
#     },
#     "openai": {
#       "base_url": "https://api.openai.com/v1",
#       "api_key": "sk-your-key",
#       "models": ["gpt-4*", "gpt-5*", "deepseek-*", "claude-*", "gemini-*"]
#     }
#   }
# }
