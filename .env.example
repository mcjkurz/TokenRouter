# TokenRouter Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# API key for the upstream LLM provider
PROVIDER_API_KEY=your-api-key-here

# Base URL for the upstream LLM provider API
PROVIDER_BASE_URL=https://api.poe.com/v1

# Password for admin panel authentication
ADMIN_PASSWORD=your-secure-admin-password

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Host to bind the server to (use 0.0.0.0 for external access)
HOST=127.0.0.1

# Port to run the server on
PORT=8000

# Public URL for API documentation (shown to users for client configuration)
PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# MODEL SETTINGS
# =============================================================================

# Default model to use when none specified
DEFAULT_MODEL=GPT-5-nano

# Comma-separated list of allowed models
ALLOWED_MODELS=GPT-5.1,GPT-5.1-Instant,GPT-5-nano,GPT-5-mini,GPT-5,Gemini-2.5-Flash,Gemini-2.5-Pro,Claude-Haiku-4.5,Claude-Sonnet-4.5,DeepSeek-R1,DeepSeek-V3.2,qwen3-coder-next:latest

# Timeout for provider API requests (in seconds)
PROVIDER_TIMEOUT=120.0

# =============================================================================
# DATABASE
# =============================================================================

# SQLite database URL
DATABASE_URL=sqlite:///./data/tokenrouter.db

# =============================================================================
# USER REGISTRATION
# =============================================================================

# Enable or disable user registration (true/false)
REGISTRATION_ENABLED=true

# Comma-separated access codes required for registration (leave empty to disable)
REGISTRATION_ACCESS_CODES=

# Comma-separated list of allowed email domains for registration
ALLOWED_EMAIL_DOMAINS=ln.hk,ln.edu.hk

# Default token quota for newly registered users
DEFAULT_REGISTRATION_QUOTA=500000

# =============================================================================
# API DOCUMENTATION
# =============================================================================

# Enable Swagger/OpenAPI documentation at /docs (true/false)
ENABLE_API_DOCS=false
